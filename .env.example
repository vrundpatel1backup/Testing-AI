# Microsoft Graph API
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here
MICROSOFT_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_RECIPIENT=where-to-send@example.com

# App Configuration
CHECK_INTERVAL_MINUTES=15
NOTIFICATION_DELAY_SECONDS=300

# NextAuth (optional - for future auth implementation)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your_secret_here_generate_with_openssl_rand_base64_32
