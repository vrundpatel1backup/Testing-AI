# ============================================================
# Teams Gmail Notifier - Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
# ============================================================

# Microsoft Graph API (from Azure Portal)
# Get these from: Azure Portal > App registrations > Your App
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here

# For local development use: http://localhost:3000/api/auth/callback
# For production use: https://your-app.vercel.app/api/auth/callback
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Gmail SMTP Configuration
# GMAIL_USER: Your Gmail address that will send notifications
# GMAIL_APP_PASSWORD: 16-character app password (no spaces!)
# GMAIL_RECIPIENT: Email address where notifications will be sent
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_no_spaces
GMAIL_RECIPIENT=where-to-send-notifications@example.com

# App Configuration
# How often to check for missed messages (in minutes)
CHECK_INTERVAL_MINUTES=15

# How long a message must be unread before triggering notification (in seconds)
# Default: 300 seconds = 5 minutes
NOTIFICATION_DELAY_SECONDS=300

# Cron Secret (Security)
# Generate a strong random secret for cron job authentication
# Command to generate: openssl rand -base64 32
CRON_SECRET=your_random_secret_here_generate_with_openssl

# NextAuth Configuration (Optional - for future features)
# For local: http://localhost:3000
# For production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here_generate_with_openssl_rand_base64_32

# ============================================================
# Important Notes:
# ============================================================
# 1. NEVER commit .env.local to Git (it's in .gitignore)
# 2. For Vercel deployment, add all these variables in:
#    Vercel Dashboard > Your Project > Settings > Environment Variables
# 3. Update MICROSOFT_REDIRECT_URI after Vercel deployment
# 4. Remove spaces from GMAIL_APP_PASSWORD
# 5. Generate CRON_SECRET with: openssl rand -base64 32
# ============================================================
